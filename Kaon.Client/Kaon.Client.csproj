<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaon\Kaon.csproj" />
    <ProjectReference Include="..\Kaon.Gen\Kaon.Gen.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\client.config.json" Link="client.config.json" CopyToOutputDirectory="Always" />
    <None Include="..\client-entry.config.json" Link="client-entry.config.json" CopyToOutputDirectory="Always" />
    <None Include="..\client-provider.config.json" Link="client-provider.config.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Old Packet client listener is kept for reference only. -->
  <ItemGroup>
    <Compile Remove="Legacy\**\*.cs" />
  </ItemGroup>

</Project>
