<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kaon.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaon\Kaon.csproj" />
    <ProjectReference Include="..\Kaon.Gen\Kaon.Gen.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\server.config.json" Link="server.config.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Old Packet server listener is kept for reference only. -->
  <ItemGroup>
    <Compile Remove="Legacy\**\*.cs" />
  </ItemGroup>

</Project>
